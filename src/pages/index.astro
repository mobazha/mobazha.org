---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import DemoHighlight from '../components/DemoHighlight.astro';
import TrustBar from '../components/TrustBar.astro';
import ThreePillars from '../components/ThreePillars.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Decentralized Ecommerce Platform for Independent Sellers | Mobazha"
  description="Mobazha is a decentralized marketplace and P2P ecommerce platform for independent sellers. Launch a Web3 storefront, accept supported crypto payments, and sell directly through your own store or Telegram community with portable data and clear terms."
>
  <Header />
  <main>
    <Hero />
    <DemoHighlight />
    <TrustBar />
    <ThreePillars />
    <HowItWorks />
    <CTA />
  </main>
  <Footer />
</Layout>
